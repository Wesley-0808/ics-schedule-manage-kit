/* miniprogram/pages/rrule-tool/rrule-tool.wxss */
.container {
  padding: 20px;
}

.form-item {
  display: flex;
  align-items: flex-start;
  padding: 16px 0;
  border-bottom: 1rpx solid #eee;
}

.form-label {
  width: 120px;
  flex-shrink: 0;
  color: rgba(0, 0, 0, 0.9);
  font-size: 14px;
  line-height: 22px;
  padding-right: 12px;
}

.t-radio-group, .t-checkbox-group {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.t-button {
  margin-top: 20px;
}
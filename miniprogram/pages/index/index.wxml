<view class="container">
  <t-message id="t-message" />
  <t-toast id="t-toast" />

  <view class="header">
    <t-button theme="primary" size="large" block bindtap="showCreateCalendarDialog">创建新日历</t-button>
    <t-button theme="default" size="large" block bindtap="navigateToTimestampTool" style="margin-top: 10px;">时间戳工具</t-button>
    <t-button theme="default" size="large" block bindtap="navigateToRruleTool" style="margin-top: 10px;">RRULE 工具</t-button>
  </view>

  <t-cell-group wx:if="{{calendars.length > 0}}">
    <t-cell wx:for="{{calendars}}" wx:key="id" title="{{item.name}}" hover arrow bindtap="navigateToCalendarDetail" data-calendar-id="{{item.id}}">
      <view slot="description">
        <text>{{item.description || '暂无描述'}}</text>
        <view class="calendar-color-indicator" style="background-color: {{item.color}};"></view>
      </view>
      <t-icon slot="right-icon" name="delete" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="deleteCalendar" />
    </t-cell>
  </t-cell-group>
  <view wx:else class="empty-tip">
    <text>暂无日历，快来创建一个吧！</text>
  </view>

  <t-dialog
    visible="{{showCreateDialog}}"
    title="创建新日历"
    confirm-btn="创建"
    cancel-btn="取消"
    bind:confirm="createNewCalendar"
    bind:cancel="closeCreateCalendarDialog"
  >
    <view slot="content" class="dialog-content">
      <t-input
        label="日历名称"
        placeholder="请输入日历名称"
        value="{{newCalendarName}}"
        bindchange="onNameChange"
      />
      <t-input
        label="日历描述"
        placeholder="请输入日历描述 (可选)"
        value="{{newCalendarDescription}}"
        bindchange="onDescriptionChange"
      />
      <view class="color-picker">
        <text class="color-picker-label">选择颜色:</text>
        <view class="color-options">
          <view
            wx:for="{{colors}}"
            wx:key="*this"
            class="color-box {{item === newCalendarColor ? 'selected' : ''}}"
            style="background-color: {{item}};"
            data-color="{{item}}"
            bindtap="onColorSelect"
          ></view>
        </view>
      </view>
    </view>
  </t-dialog>
</view>